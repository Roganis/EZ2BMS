{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EZ2BMS",
  "version": "0.1.0",
  "identifier": "io.github.roganis.ez2bms",
  "build": {
    "frontendDist": "../apps/editor/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @ez2bms/editor dev",
    "beforeBuildCommand": "pnpm --filter @ez2bms/editor build"
  },
  "app": {
    "windows": [
      {
        "title": "EZ2BMS",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#05060a",
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "category": "Music",
    "shortDescription": "Chart editor for EZ2PORT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../fonts/": "fonts/"
    }
  }
}
